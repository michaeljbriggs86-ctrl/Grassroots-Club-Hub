name: Build Shooters Hill Cloud APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-24.04

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Find Android source ZIP
        shell: bash
        run: |
          set -euo pipefail

          mapfile -t SOURCE_ZIPS < <(
            find . -maxdepth 1 -type f -iname '*Android*.zip' -print | sort
          )

          if [ "${#SOURCE_ZIPS[@]}" -eq 0 ]; then
            echo "ERROR: No Android source ZIP found in repository root."
            ls -la
            exit 1
          fi

          if [ "${#SOURCE_ZIPS[@]}" -gt 1 ]; then
            echo "ERROR: More than one Android source ZIP found."
            printf ' - %s\n' "${SOURCE_ZIPS[@]}"
            exit 1
          fi

          SOURCE_ZIP="${SOURCE_ZIPS[0]}"
          echo "Using: $SOURCE_ZIP"

          rm -rf extracted
          mkdir extracted
          unzip -q "$SOURCE_ZIP" -d extracted

          SETTINGS="$(find extracted -type f -name settings.gradle -print -quit)"

          if [ -z "$SETTINGS" ]; then
            echo "ERROR: settings.gradle not found in ZIP."
            find extracted -maxdepth 5 -type f | sort
            exit 1
          fi

          PROJECT_DIR="$(dirname "$SETTINGS")"

          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"
          echo "Project directory: $PROJECT_DIR"

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Verify preinstalled Android SDK
        shell: bash
        run: |
          set -euo pipefail

          echo "ANDROID_HOME=$ANDROID_HOME"
          echo "ANDROID_SDK_ROOT=$ANDROID_SDK_ROOT"

          test -f "$ANDROID_HOME/platforms/android-35/android.jar"
          test -d "$ANDROID_HOME/build-tools/35.0.0"

          echo "Android 35 platform found."
          echo "Build Tools 35.0.0 found."

          ls "$ANDROID_HOME/platforms" | tail
          ls "$ANDROID_HOME/build-tools"

      - name: Set up Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Show environment
        shell: bash
        run: |
          java -version
          gradle --version
          echo "Android SDK: $ANDROID_HOME"
          echo "Project: $PROJECT_DIR"

      - name: Build APK
        shell: bash
        run: |
          set -euo pipefail

          cd "$PROJECT_DIR"

          gradle :app:assembleDebug \
            --no-daemon \
            --stacktrace

      - name: Locate APK
        shell: bash
        run: |
          set -euo pipefail

          APK="$PROJECT_DIR/app/build/outputs/apk/debug/app-debug.apk"

          if [ ! -f "$APK" ]; then
            echo "ERROR: APK was not created."
            find "$PROJECT_DIR/app/build/outputs" -type f 2>/dev/null || true
            exit 1
          fi

          cp "$APK" Shooters-Hill-Team-Tracker.apk

          echo "APK successfully created:"
          ls -lh Shooters-Hill-Team-Tracker.apk

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Shooters-Hill-Team-Tracker-APK
          path: Shooters-Hill-Team-Tracker.apk
          if-no-files-found: error
