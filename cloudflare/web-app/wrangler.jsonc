{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grassroots-club-hub",
  "compatibility_date": "2026-09-26",
  "main": "./src/index.js",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/__health"]
  }
}
