{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitchkind-selkent-shadow",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["15 */6 * * *", "0,30 8-19 * * SUN"]
  },
  "r2_buckets": [
    {
      "binding": "SHADOW_SNAPSHOTS",
      "bucket_name": "pitchkind-selkent-shadow"
    }
  ],
  "observability": {
    "enabled": true
  }
}
